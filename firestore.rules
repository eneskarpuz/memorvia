rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(coupleId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // Fields only the backend (Admin SDK) may change.
    function touchesProtected() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
        .hasAny(['coupleId', 'partnerId', 'pairCelebrated']);
    }

    function validPhoto(data) {
      return !('photo' in data) || data.photo == null ||
        (data.photo is string && data.photo.size() < 700000);
    }

    // ---- Users ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || resource.data.partnerId == request.auth.uid);

      allow create: if signedIn() && request.auth.uid == uid &&
        !request.resource.data.keys().hasAny(['coupleId', 'partnerId', 'pairCelebrated']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 40 &&
        validPhoto(request.resource.data);

      // pairCelebrated may only be flipped to true by the user (to dismiss the modal).
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.get('name', '').size() <= 40 &&
        validPhoto(request.resource.data) &&
        (!touchesProtected() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairCelebrated']) &&
           request.resource.data.pairCelebrated == true));

      // FCM token etc. — only the owner (and the backend) can see it.
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---- Pair codes ----------------------------------------------------------
    // Clients can only create their own code; joining is done by the backend.
    match /pairCodes/{code} {
      allow read: if signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid &&
        code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- Couples -------------------------------------------------------------
    match /couples/{coupleId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if isMember(coupleId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate']);

      // Answers: you can always read your own; your partner's only after you answered.
      match /answers/{answerId} {
        allow read: if isMember(coupleId) &&
          (resource.data.uid == request.auth.uid ||
           exists(/databases/$(database)/documents/couples/$(coupleId)/answers/$(resource.data.qid + '__' + request.auth.uid)));
        allow create: if isMember(coupleId) &&
          request.resource.data.uid == request.auth.uid &&
          answerId == request.resource.data.qid + '__' + request.auth.uid &&
          request.resource.data.answer is string &&
          request.resource.data.answer.size() <= 500;
      }

      // Who answered what (no answer content) — lets the app show "partner answered".
      match /progress/{qid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) &&
          request.auth.uid in request.resource.data.uids &&
          request.resource.data.uids.size() <= 2;
      }

      match /memories/{memoryId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          validPhoto(request.resource.data);
        allow update, delete: if isMember(coupleId) && resource.data.authorUid == request.auth.uid;
      }

      match /lists/{itemId} {
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId) &&
          request.resource.data.addedBy == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200;
        allow update: if isMember(coupleId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
      }
    }
  }
}
