# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase v27+ (Firebase Apple SDK via SPM) requires dynamic frameworks
use_frameworks! :linkage => :dynamic

target 'Memorvia' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Some pods (e.g. react-native-image-picker's privacy bundle) declare iOS 9.0,
    # which current Xcode rejects. Raise them to the app's minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        if bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          bc.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
        # With dynamic frameworks the image picker must link these itself.
        if target.name == 'react-native-image-picker'
          bc.build_settings['OTHER_LDFLAGS'] = ['$(inherited)', '-framework', 'UniformTypeIdentifiers', '-framework', 'MobileCoreServices']
        end
      end
    end
  end
end
