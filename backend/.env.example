# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the JSON, keeping the \n sequences, wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# https://www.themoviedb.org/settings/api  ("API Read Access Token")
TMDB_READ_TOKEN=

# Google Cloud Console: enable "Places API (New)", restrict the key to that API
GOOGLE_PLACES_KEY=
